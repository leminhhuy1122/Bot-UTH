# ==============================================================================
# BIẾN MÔI TRƯỜNG HỆ THỐNG CỔNG SINH VIÊN & TRỢ LÝ ẢO UTH
# ==============================================================================

# 1. GOOGLE GEMINI AI API KEY (Tùy chọn)
# Đăng ký miễn phí tại: https://aistudio.google.com
# Nếu để trống, hệ thống sẽ tự động dùng Python NLP Engine RAG Fallback
GEMINI_API_KEY=""

# 2. NEON.TECH POSTGRESQL DATABASE URL (Khuyên dùng khi Deploy)
# Đăng ký miễn phí 1GB tại: https://neon.tech (chọn Region Singapore ap-southeast-1)
# Sao chép chuỗi Pooled Connection (có đuôi -pooler):
# Ví dụ: postgresql://username:password@ep-cool-fog-123456-pooler.ap-southeast-1.neon.tech/neondb?sslmode=require
# Nếu để trống, hệ thống sẽ tự động chạy trên CSDL cục bộ SQLite (data/uth_portal.db)
DATABASE_URL=""

# 3. CỔNG MÁY CHỦ
PORT=8000
HOST="0.0.0.0"

# 4. BẢO MẬT XÁC THỰC JWT & CORS (Bắt buộc cho Production)
# Tạo khóa ngẫu nhiên 256-bit bằng lệnh: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="your_super_secret_jwt_key_256bit_hex"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,https://your-domain.edu.vn"
