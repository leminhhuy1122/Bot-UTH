# ==============================================================================
# BIẾN MÔI TRƯỜNG HỆ THỐNG CỔNG SINH VIÊN & TRỢ LÝ ẢO UTH
# ==============================================================================

# 1. GOOGLE GEMINI AI API KEY (Mô hình chính - Khuyên dùng)
# Đăng ký miễn phí tại: https://aistudio.google.com
# Hỗ trợ tự động: gemini-3.8-flash, gemini-3.5-flash, gemini-3.5-flash-lite
GEMINI_API_KEY=""

# 1.1 MÔ HÌNH DỰ PHÒNG MULTI-PROVIDER AI (Tùy chọn bổ sung)
# Khi Gemini gặp sự cố mạng hoặc hết quota, bot tự động switch sang các model này:
# - OpenAI: Đăng ký tại https://platform.openai.com
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# - Groq (Cực nhanh, miễn phí): Đăng ký tại https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. NEON.TECH POSTGRESQL DATABASE URL (Khuyên dùng khi Deploy)
# Đăng ký miễn phí 1GB tại: https://neon.tech (chọn Region Singapore ap-southeast-1)
# Sao chép chuỗi Pooled Connection (có đuôi -pooler):
# Ví dụ: postgresql://username:password@ep-cool-fog-123456-pooler.ap-southeast-1.neon.tech/neondb?sslmode=require
# Nếu để trống, hệ thống sẽ tự động chạy trên CSDL cục bộ SQLite (data/uth_portal.db)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
NEON_BRANCH="production"

# 3. CỔNG MÁY CHỦ
PORT=8008
BACKEND_PORT=8008 # Cổng mặc định UTH, tự động chuyển 8009, 8010... nếu bận
HOST="0.0.0.0"

# 4. BẢO MẬT XÁC THỰC JWT & CORS (Bắt buộc cho Production)
JWT_SECRET_KEY="your_super_secret_jwt_key_256bit_hex"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
